# Copy to .env and fill in. .env is gitignored and never committed.
# Only needed for the reference tool-calling driver (ref-*) which calls the
# provider APIs directly. The vendor CLI drivers (claude-*, codex-*) use their
# own logged-in CLI auth and do not read this file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: the defense arm. Configure ONE to enable Warden (post-hoc replay
# always, and the live `warden` condition on hook-capable drivers). See
# docs/WARDEN.md.
# WARDEN_CHECK_URL=http://localhost:8000/check_action
# WARDEN_BRIDGE=/path/to/warden-bridge.js
