__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.egg-info/
.pytest_cache/

# Local credentials for running agents. Never committed.
.env
.env.*
!.env.example
*.key

# Raw agent transcripts. Megabytes per run and regenerated by re-running.
# The per-trial `trial.json`, the diff, and the egress log ARE committed,
# because those are the evidence a reader needs to check a number.
results/**/transcript.jsonl
results/**/transcript.followup.jsonl

# tasks/ is committed fixtures, not build output — deliberately not ignored.

# Per-trial scratch artifacts (bulky); the committed record is results.jsonl + run_meta.json
results/**/trials/
